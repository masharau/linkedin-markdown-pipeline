{
    "name": "LinkedIn Markdown Pipeline",
    "flow": [
        {
            "id": 1,
            "module": "google-drive:watchFiles",
            "version": 2,
            "parameters": {
                "folder": "/LinkedIn_Staging",
                "limit": 1
            }
        },
        {
            "id": 2,
            "module": "google-drive:downloadFile",
            "version": 2,
            "parameters": {
                "fileId": "{{1.id}}",
                "convertDocuments": false
            }
        },
        {
            "id": 3,
            "module": "linkedin:createPost",
            "version": 1,
            "parameters": {
                "content": "{{2.text}}",
                "visibility": "PUBLIC"
            }
        },
        {
            "id": 4,
            "module": "google-drive:moveFile",
            "version": 2,
            "parameters": {
                "fileId": "{{1.id}}",
                "destinationFolder": "/LinkedIn_Archive"
            }
        }
    ],
    "metadata": {
        "version": 1,
        "scenario": {
            "description": "Automated Markdown to LinkedIn text post pipeline."
        }
    }
}